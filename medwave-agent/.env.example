# ─────────────────────────────────────────────────────────────
# MedWave Agent — Environment Variables
# Copy this to .env.local for local dev (never commit .env.local)
# Add these as Environment Variables in Vercel dashboard
# ─────────────────────────────────────────────────────────────

# Z.AI GLM-4.5 API Key
# Get from: https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=your_zai_key_here

# GoHighLevel CRM — Read-Only Location API Key
# Get from: GHL → Settings → API Keys → Create new key (read-only)
GHL_API_KEY=your_ghl_key_here
GHL_LOCATION_ID=QdLXaFEqrdF0JbVbpKLw

# Email (SMTP) for sending lead alerts to Davide
# Use Gmail App Password: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@medwavegroup.com
SMTP_PASS=your_gmail_app_password_here
ALERT_EMAIL=info@medwavegroup.com

# App auth — simple shared secret for team login
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=generate_a_random_32_char_string_here

# Team passwords (plain text here, hashed on first use in production)
TEAM_PASSWORD_DAVIDE=choose_a_strong_password
TEAM_PASSWORD_FRANCOIS=choose_a_strong_password
TEAM_PASSWORD_ERICH=choose_a_strong_password
TEAM_PASSWORD_STERRENBERG=choose_a_strong_password
TEAM_PASSWORD_HAZEL=choose_a_strong_password
TEAM_PASSWORD_AZOLA=choose_a_strong_password
